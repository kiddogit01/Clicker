<?xml version="1.0" encoding="utf-8"?>
<com.kiddo.autotapper.DraggableToolbar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbarRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/expandedRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/step_card_background"
        android:padding="8dp"
        android:elevation="12dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="▶ Démarrer"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#0D0E15"
            android:backgroundTint="@color/kiddo_green"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnQuit"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/kiddo_white"
            android:backgroundTint="#FF4444" />

    </LinearLayout>

    <TextView
        android:id="@+id/collapsedStrip"
        android:layout_width="22dp"
        android:layout_height="64dp"
        android:background="@drawable/collapsed_strip_bg"
        android:gravity="center"
        android:text="⋮"
        android:textColor="@color/kiddo_white"
        android:textStyle="bold"
        android:elevation="12dp"
        android:visibility="gone" />

</com.kiddo.autotapper.DraggableToolbar>
