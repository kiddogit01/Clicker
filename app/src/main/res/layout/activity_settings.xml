<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiddo_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Style de la cible"
        android:textColor="@color/kiddo_white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/optionFinger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/step_card_background"
        android:padding="18dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👆🏽  Doigt"
            android:textColor="@color/kiddo_white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/checkFinger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/kiddo_pink"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionCircle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/step_card_background"
        android:padding="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⭕  Cercle réticule"
            android:textColor="@color/kiddo_white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/checkCircle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="@color/kiddo_muted"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>
