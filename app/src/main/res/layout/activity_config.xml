<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <!-- ===== Barre supérieure (logo à gauche, pas de retour : c'est l'accueil) ===== -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgLogoSmall"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configuration"
                    android:textColor="@color/kiddo_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Régle la vitesse, puis lance la cible."
                    android:textColor="@color/kiddo_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Carte intervalle ===== -->
        <LinearLayout
            android:id="@+id/cardInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/step_card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Intervalle entre chaque tap"
                android:textColor="@color/kiddo_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIntervalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="100 ms"
                android:textColor="@color/kiddo_cyan"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIntervalHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:text="millisecondes entre chaque appui"
                android:textColor="@color/kiddo_muted"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekInterval"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:max="950"
                android:progress="50"
                android:progressTint="@color/kiddo_cyan"
                android:thumbTint="@color/kiddo_pink" />

            <LinearLayout
                android:id="@+id/chipsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip50"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/chip_bg"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="50"
                    android:textColor="@color/kiddo_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip100"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/chip_bg"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="100"
                    android:textColor="@color/kiddo_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip250"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/chip_bg"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="250"
                    android:textColor="@color/kiddo_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip500"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/chip_bg"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="500"
                    android:textColor="@color/kiddo_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip1000"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/chip_bg"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="1000"
                    android:textColor="@color/kiddo_white"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="Minimum : 50 ms — 100 ms recommandé"
                android:textColor="@color/kiddo_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ===== Carte batterie ===== -->
        <LinearLayout
            android:id="@+id/cardBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/step_card_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvBatteryIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="🔋"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBatteryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batterie : non protégée"
                    android:textColor="@color/kiddo_yellow"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBatteryDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="L'OS peut arrêter la bulle en arrière-plan"
                    android:textColor="@color/kiddo_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="wrap_content"
                android:minHeight="0dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_ghost"
                android:gravity="center"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Exempter"
                android:textAllCaps="false"
                android:textColor="@color/kiddo_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== CTA ===== -->
        <Button
            android:id="@+id/btnToggleTapper"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/btn_primary_bg"
            android:text="🎯  Lancer la cible et les contrôles"
            android:textAllCaps="false"
            android:textColor="@color/kiddo_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConfigStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Deux éléments vont apparaître par-dessus tes autres apps : la cible (à glisser où tu veux taper) et la barre de contrôle."
            android:textColor="@color/kiddo_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_ghost"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="⚙️  Style de la cible"
            android:textAllCaps="false"
            android:textColor="@color/kiddo_muted"
            android:textSize="13sp" />

        <!-- ===== Suivez-nous (liens gamelvup.com) ===== -->
        <TextView
            android:id="@+id/suivezTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.06"
            android:text="SUIVEZ-NOUS"
            android:textColor="@color/kiddo_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/suivezRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/socialTikTok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/step_card_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_tiktok" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="TikTok"
                    android:textColor="@color/kiddo_white"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/socialYouTube"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/step_card_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_youtube" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="YouTube"
                    android:textColor="@color/kiddo_white"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/socialFacebook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/step_card_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_facebook" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Facebook"
                    android:textColor="@color/kiddo_white"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/socialWhatsApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/step_card_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_whatsapp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="WhatsApp"
                    android:textColor="@color/kiddo_white"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:text="KidCliker - GAME Lv-UP ©2026"
            android:textColor="@color/kiddo_footer"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
