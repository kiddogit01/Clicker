<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiddo_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="キKiddoシ"
            android:textColor="@color/kiddo_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Auto Tapper"
            android:textColor="@color/kiddo_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="28dp" />

        <!-- Étape 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/step_card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvStep1Number"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/step_number_bg"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/kiddo_white"
                android:textStyle="bold"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Affichage par-dessus les autres apps"
                android:textColor="@color/kiddo_white"
                android:textSize="14sp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnOverlayPermission"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Activer"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="@color/kiddo_cyan"
                android:textColor="#0D0E15" />
        </LinearLayout>

        <!-- Étape 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/step_card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvStep2Number"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/step_number_bg"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/kiddo_white"
                android:textStyle="bold"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Service d'accessibilité"
                android:textColor="@color/kiddo_white"
                android:textSize="14sp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnAccessibilityPermission"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Activer"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="@color/kiddo_cyan"
                android:textColor="#0D0E15" />
        </LinearLayout>

        <!-- Étape 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/step_card_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvStep3Number"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/step_number_bg"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/kiddo_white"
                android:textStyle="bold"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ignorer l'optimisation de batterie"
                android:textColor="@color/kiddo_white"
                android:textSize="14sp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnBatteryOptimization"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Activer"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="@color/kiddo_cyan"
                android:textColor="#0D0E15" />
        </LinearLayout>

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Continuer →"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/kiddo_white"
            android:background="@drawable/btn_primary_bg"
            android:enabled="false"
            android:alpha="0.4" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/kiddo_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Complète les 3 étapes ci-dessus pour continuer." />

    </LinearLayout>
</ScrollView>
